diff --git a/frontend-race/src/components/RaceDetails.jsx b/frontend-race/src/components/RaceDetails.jsx
new file mode 100644
index 0000000..1b9d9ff
--- /dev/null
+++ b/frontend-race/src/components/RaceDetails.jsx
@@ -0,0 +1,64 @@
+import { formatMoney, formatShortDate } from "../dateUtils";
+import { sortCosts } from "../summary";
+import Modal from "./Modal.jsx";
+import RaceBar from "./RaceBar.jsx";
+import "./TransactionList.css";
+
+// Read-only view of one race: totals up top, then every cost on it.
+export default function RaceDetails({ race, costs, onClose }) {
+  const mine = sortCosts(costs.filter((c) => c.race_id === race.id));
+  const paid = mine.filter((c) => c.status === "paid").reduce((s, c) => s + c.amount, 0);
+  const planned = mine.filter((c) => c.status !== "paid").reduce((s, c) => s + c.amount, 0);
+  const meta = [race.type, race.date ? formatShortDate(race.date) : ""].filter(Boolean).join(" · ");
+
+  return (
+    <Modal title={race.name} onClose={onClose}>
+      {meta && <p className="text-muted race-detail__meta">{meta}</p>}
+
+      <RaceBar budget={Number(race.budget) || 0} paid={paid} planned={planned} />
+      <div className="race-stats">
+        <div>
+          <span className="text-muted">Paid</span>
+          <span className="mono">{formatMoney(paid)}</span>
+        </div>
+        <div>
+          <span className="text-muted">Still planned</span>
+          <span className="mono">{formatMoney(planned)}</span>
+        </div>
+        <div>
+          <span className="text-muted">Costs</span>
+          <span className="mono">{mine.length}</span>
+        </div>
+      </div>
+
+      <h3 className="section-title race-detail__title">All costs</h3>
+      {mine.length === 0 ? (
+        <div className="banner banner--empty">No costs on this race yet.</div>
+      ) : (
+        <ul className="txn-list race-detail__list">
+          {mine.map((c) => (
+            <li className="txn-row" key={c.id}>
+              <div className="txn-row__info">
+                <span className="txn-row__name">
+                  {c.name}
+                  {c.status !== "paid" && <span className="tag tag--planned">planned</span>}
+                  {c.transaction_id && <span className="tag tag--budget">in Mini Budget</span>}
+                </span>
+                <span className="txn-row__meta">{[c.date ? formatShortDate(c.date) : "No date", c.category].join(" · ")}</span>
+                {c.note && <span className="txn-row__meta">{c.note}</span>}
+              </div>
+              <span className="mono txn-row__amount txn-row__amount--expense">{formatMoney(c.amount)}</span>
+            </li>
+          ))}
+        </ul>
+      )}
+
+      {mine.length > 0 && (
+        <div className="race-detail__total">
+          <span>Total</span>
+          <span className="mono">{formatMoney(paid + planned)}</span>
+        </div>
+      )}
+    </Modal>
+  );
+}
